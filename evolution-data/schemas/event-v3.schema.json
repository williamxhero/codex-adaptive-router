{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Router privacy-bounded evidence event v3",
  "type": "object",
  "required": ["schema_version", "event_id", "sequence", "type", "created_at", "task_ref", "route_id"],
  "properties": {
    "schema_version": {"const": 3},
    "event_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"enum": ["route", "execution", "outcome"]},
    "created_at": {"type": "string", "maxLength": 40},
    "dedupe_key": {"type": "string", "pattern": "^[A-Za-z0-9:._-]{1,180}$"},
    "task_ref": {"type": "string", "pattern": "^[0-9a-f]{24,64}$"},
    "route_id": {"type": "string", "format": "uuid"},
    "task_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{24,64}$"},
    "profile": {"enum": ["generic", "quant"]},
    "task_class": {"enum": ["direct", "discovery", "execution", "implementation", "diagnosis", "research", "architecture", "audit", "exploration"]},
    "role": {"enum": ["direct", "router_code_mapper", "router_experiment_runner", "router_research_engineer", "router_researcher", "router_architect", "router_adversarial_auditor", "router_strategy_scout"]},
    "model": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_features": {"type": "object", "required": ["feature_version", "operation_mode", "scope", "spec_state", "reversibility", "cognitive_type", "risk_domains", "workload", "verification_depth", "evidence_state", "decision_impact", "novelty", "user_constraints", "feature_source", "confidence"], "properties": {"feature_version": {"const": 2}, "operation_mode": {"enum": ["answer", "diagnose", "change", "review", "research", "execute", "monitor"]}, "scope": {"enum": ["tiny", "bounded", "multi_file", "cross_system"]}, "spec_state": {"enum": ["unknown", "ambiguous", "frozen"]}, "reversibility": {"enum": ["reversible", "costly", "irreversible"]}, "cognitive_type": {"enum": ["direct", "discovery", "execution", "implementation", "diagnosis", "research", "architecture", "audit", "exploration"]}, "risk_domains": {"type": "array", "items": {"enum": ["quantitative_research", "high_impact", "security", "privacy", "production", "financial", "legal", "medical"]}}, "workload": {"enum": ["small", "medium", "large", "batch"]}, "verification_depth": {"enum": ["basic", "standard", "deep", "adversarial"]}, "evidence_state": {"enum": ["unknown", "consistent", "conflicting"]}, "decision_impact": {"enum": ["low", "medium", "high", "critical"]}, "novelty": {"enum": ["routine", "novel", "open_ended"]}, "user_constraints": {"type": "array", "items": {"enum": ["role", "model", "reasoning_effort", "no_delegation"]}}, "feature_source": {"enum": ["structured_heuristic", "caller_supplied", "legacy_v1"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "constraints": {"type": "object", "properties": {"role": {"enum": ["direct", "router_code_mapper", "router_experiment_runner", "router_research_engineer", "router_researcher", "router_architect", "router_adversarial_auditor", "router_strategy_scout"]}, "model": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]}, "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}, "no_delegation": {"type": "boolean"}}, "additionalProperties": false},
    "policy_revision": {"type": "integer", "minimum": 1},
    "shadow": {"type": ["object", "null"]},
    "session": {"type": "string", "pattern": "^[0-9a-f]{24,64}$"},
    "project": {"type": "string", "pattern": "^[0-9a-f]{24,64}$"},
    "plan_version": {"const": 2},
    "capability_floor": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]},
    "effort_basis": {"type": "array", "items": {"enum": ["mechanical_basic", "default", "broad_scope", "frozen_implementation", "deep_verification", "conflicting_evidence", "costly_impact", "audit", "open_ended", "irreversible_or_critical", "high_impact_exceptional_result", "explicit_constraint", "policy_override", "role_clamp"]}},
    "route_mode": {"enum": ["single", "staged"]},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["stage", "authority", "role", "capability_floor", "model", "reasoning_effort", "required"], "properties": {"stage": {"enum": ["frame", "collect", "implement", "verify", "synthesize", "audit"]}, "authority": {"enum": ["evidence", "implementation", "decision", "audit"]}, "role": {"type": "string"}, "capability_floor": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]}, "model": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]}, "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}, "required": {"type": "boolean"}}, "additionalProperties": false}},
    "capability_exception": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["requested_model", "required_floor", "disposition", "decision_owner_model", "reason"], "properties": {"requested_model": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]}, "required_floor": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]}, "disposition": {"const": "worker_only"}, "decision_owner_model": {"const": "gpt-5.6-sol"}, "reason": {"const": "requested_model_below_capability_floor"}}, "additionalProperties": false}]},
    "event": {"enum": ["PostToolUse", "SubagentStart", "SubagentStop", "SessionStart", "UserPromptSubmit", "Stop", "SessionEnd"]},
    "tool_kind": {"enum": ["shell", "edit", "agent", "mcp", "local", "lifecycle"]},
    "failed": {"type": "boolean"},
    "verification_kind": {"type": ["string", "null"]},
    "transition": {"type": "object", "required": ["phase", "role", "model", "reasoning_effort"], "properties": {"phase": {"enum": ["start", "stop"]}, "role": {"type": "string"}, "model": {"type": "string"}, "reasoning_effort": {"type": "string"}}, "additionalProperties": false},
    "status": {"enum": ["completed", "verified", "failed", "corrected", "escalated", "overridden"]},
    "quality_gate": {"enum": ["unknown", "provisional", "passed", "failed"]},
    "route_fit": {"enum": ["unknown", "adequate", "under_routed", "over_routed"]},
    "verification_kinds": {"type": "array", "items": {"enum": ["tests", "build", "static_validation", "review"]}},
    "evidence_source": {"enum": ["objective", "hook_heuristic", "user_explicit", "legacy_v1"]},
    "objective_verification": {"type": "boolean"},
    "user_confirmed": {"type": "boolean"},
    "replacement": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["role", "model", "reasoning_effort"], "properties": {"role": {"enum": ["direct", "router_code_mapper", "router_experiment_runner", "router_research_engineer", "router_researcher", "router_architect", "router_adversarial_auditor", "router_strategy_scout"]}, "model": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"]}, "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}}, "additionalProperties": false}]},
    "high_risk_regression": {"type": "boolean"},
    "retry_band": {"enum": ["unknown", "low", "medium", "high", "very_high"]},
    "rework_band": {"enum": ["unknown", "low", "medium", "high", "very_high"]},
    "tool_band": {"enum": ["unknown", "low", "medium", "high", "very_high"]},
    "duration_band": {"enum": ["unknown", "low", "medium", "high", "very_high"]},
    "token_band": {"enum": ["unknown", "low", "medium", "high", "very_high"]},
    "cost_band": {"enum": ["unknown", "low", "medium", "high", "very_high"]},
    "stage": {"enum": ["frame", "collect", "implement", "verify", "synthesize", "audit"]},
    "model_fit": {"enum": ["under", "adequate", "over", "unknown"]},
    "effort_fit": {"enum": ["under", "adequate", "over", "unknown"]},
    "context_fit": {"enum": ["adequate", "deficient", "unknown"]},
    "tool_data_fit": {"enum": ["adequate", "deficient", "unknown"]},
    "failure_axis": {"enum": ["model_capability", "reasoning_budget", "context", "tool_data", "execution", "none", "confounded"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "route"}}}, "then": {"required": ["task_fingerprint", "profile", "task_class", "role", "model", "reasoning_effort", "confidence", "decision_features", "constraints", "policy_revision", "shadow", "session", "project", "plan_version", "capability_floor", "effort_basis", "route_mode", "stages", "capability_exception"]}},
    {"if": {"properties": {"type": {"const": "execution"}}}, "then": {"required": ["event"]}},
    {"if": {"properties": {"type": {"const": "outcome"}}}, "then": {"required": ["status", "quality_gate", "route_fit", "verification_kinds", "confidence", "evidence_source", "objective_verification", "user_confirmed", "replacement", "high_risk_regression", "retry_band", "rework_band", "tool_band", "duration_band", "token_band", "cost_band", "model_fit", "effort_fit", "context_fit", "tool_data_fit", "failure_axis"]}}
  ],
  "additionalProperties": false
}
